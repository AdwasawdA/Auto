# Inference Service Configuration

# Server settings
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8765

# YOLO model settings
MODEL_PATH=yolov8n.pt
# Available models: yolov8n.pt (fastest), yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt (most accurate)

# Inference settings
CONF_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Device settings
DEVICE=cuda:0
# Use 'cuda:0' for NVIDIA GPU (Jetson Nano, PC with GPU)
# Use 'cpu' for CPU-only inference

# Target classes (comma-separated class IDs)
# 0 = person, 1 = bicycle, 2 = car, etc.
# See COCO dataset classes for full list
TARGET_CLASSES=0

# Logging
LOG_LEVEL=INFO